# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/iran-news-updates?retryWrites=true&w=majority

# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# OpenAI API key — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: secret used to authenticate cron job / scrape trigger requests
CRON_SECRET=your_random_secret_here

# Base URL of the deployed app (used for server-side API calls)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: set to debug for verbose server logs in local development
LOG_LEVEL=info
